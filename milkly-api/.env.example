# Database
DATABASE_URL="postgresql://milkly:milkly@localhost:5432/milkly?schema=public"

# Auth
BETTER_AUTH_SECRET="dev-secret-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Social Login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Redis
REDIS_URL="redis://localhost:6379"

# Storage (MinIO locally, S3 in production)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="milkly-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# Email
RESEND_API_KEY=""
EMAIL_FROM="noreply@milkly.app"

# AI (legacy - will be replaced by MILKLY_AI_* vars in Story 5-1)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# Portal URLs (for CORS + SSO)
APP_URL="http://localhost:8000"
LANDING_URL="http://localhost:8001"
NEWS_URL="http://localhost:8002"
AI_URL="http://localhost:8003"
EMAIL_URL="http://localhost:8004"

# Node env
NODE_ENV="development"
