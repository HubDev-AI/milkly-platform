{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@mklyml/editor/*": ["../../workspace/milkly-mklyml/mkly-editor/src/*"],
      "@mklyml/core": ["../../workspace/milkly-mklyml/mkly/src/index.ts"],
      "@mklyml/core/*": ["../../workspace/milkly-mklyml/mkly/src/*"],
      "@mklyml/kits/newsletter": ["../../workspace/milkly-mklyml/mkly-kits/newsletter/src/index.ts"],
      "@mklyml/plugins/email": ["../../workspace/milkly-mklyml/mkly-plugins/email/src/index.ts"],
      "@mkly": ["../../workspace/milkly-mklyml/mkly/src/index.ts"],
      "@mkly-kits/*": ["../../workspace/milkly-mklyml/mkly-kits/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
